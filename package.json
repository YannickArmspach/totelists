{
  "name": "tote",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node dev.js",
    "dev:web": "pnpm --filter @tote/web dev",
    "dev:tb": "pnpm --filter @tote/trailbase dev",
    "build": "pnpm --filter @tote/web build",
    "start": "pnpm --filter @tote/web start",
    "test": "pnpm --filter @tote/web test",
    "typecheck": "pnpm --filter @tote/web typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "trailbase": "^0.14.1"
    }
  }
}
