# Copy to .env for `docker compose up`. `pnpm dev` reads apps/web/.env instead.

# --- Baked into the client bundle at BUILD time (Vite import.meta.env). ---
# These are the origins the BROWSER dials, so from a laptop they are the
# localhost-mapped ports, not compose-internal hostnames.
VITE_TRAILBASE_URL=http://localhost:4000
VITE_SITE_URL=http://localhost:3000

# --- Server-only, read at runtime by the web app's API routes. Never VITE_. ---
WHISPER_URL=https://whisper-production.dev.ynk.one
WHISPER_API_KEY=
MERIDIAN_URL=https://meridian.dev.ynk.one
MERIDIAN_API_KEY=

# Set to 1 to run the voice loop offline with canned transcribe/classify
# responses (no keys needed).
FAKE_AI=

# --- TrailBase container ---
TRAILBASE_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
