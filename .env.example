# Copy to .env for `docker compose up`. `pnpm dev` reads apps/web/.env instead.

# --- Baked into the client bundle at BUILD time (Vite import.meta.env). ---
# These are the origins the BROWSER dials, so from a laptop they are the
# localhost-mapped ports, not compose-internal hostnames.
VITE_TRAILBASE_URL=http://localhost:4000
VITE_SITE_URL=http://localhost:3000

# --- Server-only, read at runtime by the web app's API routes. Never VITE_. ---
# AI gateway (Open WebUI + Ollama; local stack = docker-compose.ai.yml on 5100).
OPENWEBUI_URL=https://ai.tote.markets
OPENWEBUI_ADMIN_API_KEY=
# The two model knobs — read by the web app AND the AI stack. For local
# quality tests try qwen3:4b / gemma3:4b (see docs/service-ai.md).
MODEL_CLASSIFY=qwen3:1.7b
MODEL_TRANSCRIBE=small
# TrailBase service account (owns the ai_accounts record API).
TRAILBASE_INTERNAL_URL=http://trailbase:4000
TOTE_SVC_EMAIL=svc-ai@tote.markets
TOTE_SVC_PASSWORD=

# Set to 1 to run the voice loop offline with canned transcribe/classify
# responses (no keys needed).
FAKE_AI=

# --- TrailBase container ---
TRAILBASE_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI stack (docker compose -f docker-compose.ai.yml up) ---
# JWT signing key for Open WebUI; generate with `openssl rand -hex 32`.
OPENWEBUI_SECRET_KEY=
# Browser-facing URL. Under `pnpm dev`, Caddy terminates TLS on 5001 → 5100
# (5000 belongs to macOS AirPlay — see Caddyfile); standalone `docker compose`
# without Caddy: http://localhost:5100.
OPENWEBUI_PUBLIC_URL=https://localhost:5001
