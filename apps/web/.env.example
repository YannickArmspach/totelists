# Copy to .env for `pnpm dev`.

# Client bundle (import.meta.env — browser-visible origins).
VITE_TRAILBASE_URL=https://localhost:4000
VITE_SITE_URL=https://localhost:3000

# Server-only (process.env, read by /api/transcribe and /api/classify).
# AI gateway: Open WebUI + Ollama (local stack = docker-compose.ai.yml on 5100).
OPENWEBUI_URL=https://ai.tote.markets
OPENWEBUI_ADMIN_API_KEY=
MODEL_CLASSIFY=qwen3:4b
# TrailBase service account (owns the ai_accounts record API).
# 4100 = the dev trail instance itself; 4000 is Caddy and TLS-only.
TRAILBASE_INTERNAL_URL=http://localhost:4100
TOTE_SVC_EMAIL=svc-ai@tote.markets
TOTE_SVC_PASSWORD=

# Set to 1 to run the voice loop offline with canned responses (no keys needed).
FAKE_AI=
