# Auto-generated `config.Config` textproto.
#
# Schema: https://github.com/trailbaseio/trailbase/blob/main/crates/core/proto/config.proto
email {}
server {
  application_name: "Tote"
  logs_retention_sec: 604800
}
auth {
  auth_token_ttl_sec: 3600
  refresh_token_ttl_sec: 2592000
  redirect_uri_allowlist: ["http://localhost:3000/auth/callback", "https://tote.markets/auth/callback"]
}
jobs {
  system_jobs: [{
    id: BACKUP
    schedule: "0 0 3 * * * *"
  }]
}
record_apis: [{
  name: "totes"
  table_name: "totes"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  create_access_rule: "_REQ_.created_by = _USER_.id"
  # created_by comes first, and not only for short-circuit speed: a tote is
  # unreadable by its own creator until a tote_members row exists, and that row
  # is written after the insert resolves. Without this clause the creator never
  # sees their own row come back on the subscription, and creation deadlocks.
  read_access_rule: "_ROW_.created_by = _USER_.id OR _ROW_.visibility = \'public\' OR EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.id AND m.user_id = _USER_.id) OR EXISTS(SELECT 1 FROM tote_invites AS i JOIN _user AS u ON u.id = _USER_.id WHERE i.tote_id = _ROW_.id AND i.email = u.email COLLATE NOCASE)"
  update_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.id AND m.user_id = _USER_.id AND m.role = \'owner\')"
  delete_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.id AND m.user_id = _USER_.id AND m.role = \'owner\')"
}, {
  name: "tote_members"
  table_name: "tote_members"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  create_access_rule: "_REQ_.user_id = _USER_.id AND (EXISTS(SELECT 1 FROM totes AS t WHERE t.id = _REQ_.tote_id AND t.visibility = \'public\') OR EXISTS(SELECT 1 FROM totes AS t WHERE t.id = _REQ_.tote_id AND t.invite_code IS NOT NULL AND t.invite_code = _REQ_.joined_with_code) OR EXISTS(SELECT 1 FROM totes AS t WHERE t.id = _REQ_.tote_id AND t.created_by = _USER_.id) OR EXISTS(SELECT 1 FROM tote_invites AS i JOIN _user AS u ON u.id = _USER_.id WHERE i.tote_id = _REQ_.tote_id AND i.email = u.email COLLATE NOCASE)) AND (_REQ_.role IS NULL OR _REQ_.role = \'member\' OR EXISTS(SELECT 1 FROM totes AS t WHERE t.id = _REQ_.tote_id AND t.created_by = _USER_.id))"
  read_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id) OR EXISTS(SELECT 1 FROM totes AS t WHERE t.id = _ROW_.tote_id AND t.visibility = \'public\')"
  update_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id AND m.role = \'owner\')"
  delete_access_rule: "_ROW_.user_id = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id AND m.role = \'owner\')"
}, {
  name: "tote_invites"
  table_name: "tote_invites"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  create_access_rule: "_REQ_.created_by = _USER_.id AND EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _REQ_.tote_id AND m.user_id = _USER_.id)"
  read_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id) OR EXISTS(SELECT 1 FROM _user AS u WHERE u.id = _USER_.id AND u.email = _ROW_.email COLLATE NOCASE)"
  update_access_rule: "FALSE"
  delete_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id) OR EXISTS(SELECT 1 FROM _user AS u WHERE u.id = _USER_.id AND u.email = _ROW_.email COLLATE NOCASE)"
}, {
  name: "markets"
  table_name: "markets"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  create_access_rule: "_REQ_.created_by = _USER_.id"
  # Markets are the account's, not a tote's, so visibility no longer follows
  # tote_markets: you see your own, plus those of anyone you share a tote with.
  # Without this second clause a shared tote's members could not see each
  # other's shops, and every item routed to one would look unrouted to them.
  read_access_rule: "_ROW_.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS mine JOIN tote_members AS theirs ON theirs.tote_id = mine.tote_id WHERE mine.user_id = _USER_.id AND theirs.user_id = _ROW_.created_by)"
  update_access_rule: "_ROW_.created_by = _USER_.id"
  delete_access_rule: "_ROW_.created_by = _USER_.id"
}, {
  name: "departments"
  table_name: "departments"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  # A department no longer hangs off one market, so visibility reaches through
  # market_departments: yours, or attached to a market you can already see.
  create_access_rule: "_REQ_.created_by = _USER_.id AND (_REQ_.owner_market_id IS NULL OR EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _REQ_.owner_market_id AND (w.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS mine JOIN tote_members AS theirs ON theirs.tote_id = mine.tote_id WHERE mine.user_id = _USER_.id AND theirs.user_id = w.created_by))))"
  read_access_rule: "_ROW_.created_by = _USER_.id OR EXISTS(SELECT 1 FROM market_departments AS md JOIN markets AS w ON w.id = md.market_id WHERE md.department_id = _ROW_.id AND (w.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS mine JOIN tote_members AS theirs ON theirs.tote_id = mine.tote_id WHERE mine.user_id = _USER_.id AND theirs.user_id = w.created_by)))"
  update_access_rule: "_ROW_.created_by = _USER_.id OR EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _ROW_.owner_market_id AND w.created_by = _USER_.id)"
  delete_access_rule: "_ROW_.created_by = _USER_.id OR EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _ROW_.owner_market_id AND w.created_by = _USER_.id)"
}, {
  name: "market_departments"
  table_name: "market_departments"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  # Deliberately validates only the market, never _REQ_.department_id. The
  # classifier creates a department and attaches it in the same tick, and a
  # rule that required the department row to exist first would reintroduce the
  # creation deadlock this release just fixed (see the totes read rule).
  # Department ids are unguessable; the worst case is an attachment you cannot
  # read anyway.
  create_access_rule: "EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _REQ_.market_id AND (w.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS mine JOIN tote_members AS theirs ON theirs.tote_id = mine.tote_id WHERE mine.user_id = _USER_.id AND theirs.user_id = w.created_by)))"
  read_access_rule: "EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _ROW_.market_id AND (w.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS mine JOIN tote_members AS theirs ON theirs.tote_id = mine.tote_id WHERE mine.user_id = _USER_.id AND theirs.user_id = w.created_by)))"
  update_access_rule: "EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _ROW_.market_id AND (w.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS mine JOIN tote_members AS theirs ON theirs.tote_id = mine.tote_id WHERE mine.user_id = _USER_.id AND theirs.user_id = w.created_by)))"
  delete_access_rule: "EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _ROW_.market_id AND (w.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_members AS mine JOIN tote_members AS theirs ON theirs.tote_id = mine.tote_id WHERE mine.user_id = _USER_.id AND theirs.user_id = w.created_by)))"
}, {
  name: "tote_markets"
  table_name: "tote_markets"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  create_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _REQ_.tote_id AND m.user_id = _USER_.id) AND EXISTS(SELECT 1 FROM markets AS w WHERE w.id = _REQ_.market_id AND (w.created_by = _USER_.id OR EXISTS(SELECT 1 FROM tote_markets AS tm JOIN tote_members AS m2 ON m2.tote_id = tm.tote_id WHERE tm.market_id = w.id AND m2.user_id = _USER_.id)))"
  read_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id) OR EXISTS(SELECT 1 FROM totes AS t WHERE t.id = _ROW_.tote_id AND t.visibility = \'public\')"
  update_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id)"
  delete_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id)"
}, {
  name: "items"
  table_name: "items"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  enable_subscriptions: true
  create_access_rule: "_REQ_.created_by = _USER_.id AND EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _REQ_.tote_id AND m.user_id = _USER_.id)"
  read_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id) OR EXISTS(SELECT 1 FROM totes AS t WHERE t.id = _ROW_.tote_id AND t.visibility = \'public\')"
  update_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id)"
  delete_access_rule: "EXISTS(SELECT 1 FROM tote_members AS m WHERE m.tote_id = _ROW_.tote_id AND m.user_id = _USER_.id)"
}, {
  name: "ai_accounts"
  table_name: "ai_accounts"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  # Server-only secrets (per-user Open WebUI API keys). Every operation is
  # locked to the web server's service account; ordinary authenticated
  # browsers get a 403 on every row. No subscriptions: nothing streams keys.
  create_access_rule: "EXISTS(SELECT 1 FROM _user AS u WHERE u.id = _USER_.id AND u.email = \'svc-ai@tote.markets\')"
  read_access_rule: "EXISTS(SELECT 1 FROM _user AS u WHERE u.id = _USER_.id AND u.email = \'svc-ai@tote.markets\')"
  update_access_rule: "EXISTS(SELECT 1 FROM _user AS u WHERE u.id = _USER_.id AND u.email = \'svc-ai@tote.markets\')"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user AS u WHERE u.id = _USER_.id AND u.email = \'svc-ai@tote.markets\')"
}]